# Template file for 'linux7.2-tcachy'
pkgname=linux7.2-tcachy
version=7.2.3
revision=1
short_desc="Linux kernel and modules (${version%.*} series) with CachyOS/tkg/clear/cachymod patches with clang"
maintainer="Terromur <terromuroz@proton.me>"
license="GPL-2.0-only"
homepage="https://github.com/CachyOS/linux-cachyos"
distfiles="https://github.com/CachyOS/linux/releases/download/cachyos-${version}-1/cachyos-${version}-1.tar.gz"
checksum=b69413e1941bc9f08d0f5bdf576b4e31ebd948a235d8b8a24a81ba7583e36d77
python_version=3

build_options="bore o3 performance hz100 hz250 hz300 hz500 hz600 hz750 hz800 hz1000 tick_periodic tick_idle tick_full native_cpu disable_paravirt disable_debug disable_security memory_opt io_net_opt cpu_opt storage_fs misc_opt disable_virt disable_cgroups x86_64_v3 lto_full lto_thin"

build_options_default="o3 tick_full native_cpu memory_opt io_net_opt cpu_opt storage_fs misc_opt lto_thin"

desc_option_bore="Enable BORE CPU scheduler"
desc_option_o3="Enable KBUILD_CFLAGS -O3 compiler optimization"
desc_option_performance="Set performance governor as default"
desc_option_hz100="Set tick rate to 100Hz"
desc_option_hz250="Set tick rate to 250Hz"
desc_option_hz300="Set tick rate to 300Hz"
desc_option_hz500="Set tick rate to 500Hz"
desc_option_hz600="Set tick rate to 600Hz"
desc_option_hz750="Set tick rate to 750Hz"
desc_option_hz1000="Set tick rate to 1000Hz"
desc_option_tick_periodic="Set tick rate mode to periodic"
desc_option_tick_idle="Set tick rate mode to idle tickless"
desc_option_tick_full="Set tick rate mode to full tickless"
desc_option_native_cpu="Build for native CPU (-march=native)"
desc_option_disable_paravirt="Disable paravirt"
desc_option_disable_debug="Disable kernel debug and tracing features"
desc_option_disable_security="Disable security hardening"
desc_option_memory_opt="Disable memory tracking, HMM, KSM, THP always and other memory overhead"
desc_option_io_net_opt="Disable block layer accounting and network busy polling"
desc_option_cpu_opt="Disable CPU-hungry features, tune RCU and NR_CPUS"
desc_option_storage_fs="Enable storage and FAT filesystems as built-in"
desc_option_misc_opt="Miscellaneous performance tweaks and legacy feature removal"
desc_option_disable_virt="Disable KVM, Xen, and other virtualization guest features"
desc_option_disable_cgroups="Disable unused cgroup controllers to reduce overhead"
desc_option_x86_64_v3="Enable x86-64-v3 ISA level"
desc_option_lto_full="Enable Clang full LTO"
desc_option_lto_thin="Enable Clang thin LTO"

# XXX Restrict archs until a proper <arch>-dotconfig is available in FILESDIR.
archs="x86_64*"
nodebug=yes  # -dbg package is generated below manually
nostrip=yes
noverifyrdeps=yes
noshlibprovides=yes
preserve=yes
hostmakedepends="tar xz bc elfutils-devel flex gmp-devel kmod libmpc-devel pkg-config openssl-devel perl uboot-mkimage cpio clang22 llvm22 lld22 pahole python3 which zstd"
_kernver="${version/rc/0-rc}-tcachy_${revision}"
triggers="kernel-hooks"

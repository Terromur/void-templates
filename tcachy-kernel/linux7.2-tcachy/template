		scripts/config --disable CONFIG_BLK_CGROUP_IOLATENCY
		scripts/config --disable CONFIG_BLK_RQ_ALLOC_TIME
		scripts/config --disable CONFIG_BLK_CGROUP_IOPRIO
		scripts/config --disable CONFIG_NET_RX_BUSY_POLL
		scripts/config --disable CONFIG_NET_FLOW_LIMIT
	fi

	# CPU optimizations
	if [ "$build_option_cpu_opt" ]; then
		scripts/config --disable CONFIG_SCHED_CORE
		scripts/config --disable CONFIG_UCLAMP_TASK
		scripts/config --disable CONFIG_UCLAMP_TASK_GROUP
		scripts/config --disable CONFIG_SCHED_AUTOGROUP
		scripts/config --disable CONFIG_NUMA_BALANCING_DEFAULT_ENABLED
		scripts/config --set-val RCU_FANOUT 32
		scripts/config -d CPUMASK_OFFSTACK -d MAXSMP
		scripts/config --set-val NR_CPUS_RANGE_BEGIN 32
		scripts/config --set-val NR_CPUS_RANGE_END 32
		scripts/config --set-val NR_CPUS_DEFAULT 32
		scripts/config --set-val NR_CPUS 32
		scripts/config --set-val NODES_SHIFT 10
	fi

	# Storage and filesystems
	if [ "$build_option_storage_fs" ]; then
		scripts/config -e BLK_DEV_DM -e BLK_DEV_LOOP -e BLK_DEV_NVME
		scripts/config -e BLK_DEV_MD -d MD_AUTODETECT -d DM_INIT
		scripts/config -d MSDOS_FS -e FAT_FS -e VFAT_FS
	fi

	# Miscellaneous tweaks and legacy removal
	if [ "$build_option_misc_opt" ]; then
		scripts/config --set-val LOG_BUF_SHIFT 16
		scripts/config --set-val KVM_MAX_NR_VCPUS 128
		scripts/config -d MEMORY_HOTPLUG
		scripts/config -d POSIX_AUX_CLOCKS
		scripts/config -d SYMBOLIC_ERRNAME
		scripts/config -d BOOTTIME_TRACING -d BOOT_CONFIG
		scripts/config -d CFG80211_DEFAULT_PS
		scripts/config -d COREDUMP
		scripts/config -d EARLY_PRINTK
		scripts/config -d HIBERNATION
		scripts/config -d KEXEC_HANDOVER
		scripts/config -d X86_CHECK_BIOS_CORRUPTION
		scripts/config -d X86_VSYSCALL_EMULATION
		scripts/config -d DETECT_HUNG_TASK
		scripts/config -d HARDLOCKUP_DETECTOR
		scripts/config -d SOFTLOCKUP_DETECTOR_INTR_STORM
		scripts/config -d SOFTLOCKUP_DETECTOR
		scripts/config -d SND_UTIMER
		scripts/config -d WATCH_QUEUE
		scripts/config -d PCIEASPM_DEFAULT -e PCIEASPM_PERFORMANCE
		scripts/config -d WQ_POWER_EFFICIENT_DEFAULT
		scripts/config -d X86_BOOTPARAM_MEMORY_CORRUPTION_CHECK
		scripts/config -d X86_BUS_LOCK_DETECT
		scripts/config -d X86_CPA_STATISTICS
		scripts/config -d X86_DECODER_SELFTEST
		scripts/config -d LEGACY_VSYSCALL_XONLY -e LEGACY_VSYSCALL_NONE
		scripts/config -d UID16 -d X86_16BIT -d MODIFY_LDT_SYSCALL
		scripts/config -d SYSFS_SYSCALL
		scripts/config -d KEXEC -d KEXEC_FILE -d CRASH_DUMP
		scripts/config -d IOMMU_DEFAULT_DMA_LAZY -e IOMMU_DEFAULT_PASSTHROUGH
	fi

	# Disable virtualization guest
	if [ "$build_option_disable_virt" ]; then
		scripts/config --disable CONFIG_KVM_GUEST
		scripts/config --disable CONFIG_XEN
		scripts/config --disable CONFIG_JAILHOUSE_GUEST
		scripts/config --disable CONFIG_ACRN_GUEST
		scripts/config --disable CONFIG_BHYVE_GUEST
		scripts/config --disable CONFIG_INTEL_TDX_GUEST
		scripts/config --disable CONFIG_BALLOON
		scripts/config --disable CONFIG_BALLOON_MIGRATION
		scripts/config --disable CONFIG_PAGE_REPORTING
		scripts/config --disable CONFIG_BALLOON_COMPACTION
	fi

	# Disable cgroups features
	if [ "$build_option_disable_cgroups" ]; then
		scripts/config --disable CONFIG_CGROUP_RDMA
		scripts/config --disable CONFIG_CGROUP_DMEM
		scripts/config --disable CONFIG_CGROUP_MISC
		scripts/config --disable CONFIG_CGROUP_PERF
		scripts/config --disable CONFIG_CGROUP_CPUACCT
		scripts/config --disable CONFIG_CGROUP_NET_PRIO
		scripts/config --disable CONFIG_CGROUP_NET_CLASSID
		scripts/config --disable CONFIG_CGROUP_HUGETLB
	fi

	# Apply x86-64 v3 ISA level
	if [ "$build_option_x86_64_v3" ]; then
		scripts/config --set-val CONFIG_X86_64_VERSION 3
	fi

	# Apply native CPU microarchitecture
	if [ "$build_option_native_cpu" ]; then
		scripts/config --disable CONFIG_GENERIC_CPU
		scripts/config --enable CONFIG_X86_NATIVE_CPU
	fi

	# Disable paravirt
	if [ "$build_option_disable_paravirt" ]; then
		scripts/config --disable CONFIG_PARAVIRT
		scripts/config --disable CONFIG_PARAVIRT_XXL
		scripts/config --disable CONFIG_PARAVIRT_SPINLOCKS
		scripts/config --disable CONFIG_PARAVIRT_TIME_ACCOUNTING
		scripts/config --disable CONFIG_PARAVIRT_CLOCK
	fi

	# Let mv-debug handle module compression
	scripts/config --disable CONFIG_MODULE_COMPRESS_ALL

	make ${_toolchain_args} ${makejobs} ARCH=$arch ${_cross} ${_make_flags} oldconfig

	# Always use our revision to CONFIG_LOCALVERSION to match our pkg version.
	sed -i -e "s|^\(CONFIG_LOCALVERSION=\).*|\1\"-tcachy_${revision}\"|" .config
}

do_build() {
	local arch _args

	case "$XBPS_TARGET_MACHINE" in
		x86_64*) _args="bzImage modules"; arch=x86_64;;
	esac
	export LDFLAGS=
	export KCFLAGS="-ffile-prefix-map=$wrksrc=."
	make ${_toolchain_args} ARCH=$arch ${_cross} ${_make_flags} ${makejobs} prepare
	make ${_toolchain_args} ARCH=$arch ${_cross} ${_make_flags} ${makejobs} ${_args}
}

do_install() {
	local arch subarch _args hdrdest

	case "$XBPS_TARGET_MACHINE" in
		x86_64*) arch=x86; subarch=x86_64;;
	esac

	# Run depmod after compressing modules - makes depmod.sh a noop
	sed -i '2iexit 0' scripts/depmod.sh
	vmkdir usr/lib
	ln -sf usr/lib/ ${DESTDIR}

	# Install kernel, firmware and modules
	make ${_toolchain_args} ${makejobs} ARCH=${subarch:-$arch} INSTALL_MOD_PATH=${DESTDIR} ${_cross} ${_make_flags} modules_install

	hdrdest=${DESTDIR}/usr/src/kernel-headers-${_kernver}

	vinstall .config 644 boot config-${_kernver}
	vinstall System.map 644 boot System.map-${_kernver}

	case "$arch" in
		x86)
			vinstall arch/x86/boot/bzImage 644 boot vmlinuz-${_kernver}
			;;
	esac

	# Switch to /usr.
	vmkdir usr

	cd ${DESTDIR}/usr/lib/modules/${_kernver}
	rm -f source build
	ln -sf ../../../src/kernel-headers-${_kernver} build

	cd ${wrksrc}
	# Install required headers to build external modules
	install -Dm644 Makefile ${hdrdest}/Makefile
	install -Dm644 Kbuild ${hdrdest}/Kbuild
	install -Dm644 kernel/Makefile ${hdrdest}/kernel/Makefile
	install -Dm644 .config ${hdrdest}/.config
	for file in $(find . -name Kconfig\*); do
		mkdir -p ${hdrdest}/$(dirname $file)
		install -Dm644 $file ${hdrdest}/${file}
	done
	for file in $(find arch/${subarch:-$arch} scripts -name module.lds -o -name Kbuild.platforms -o -name Platform); do
		mkdir -p ${hdrdest}/$(dirname $file)
		install -Dm644 $file ${hdrdest}/${file}
	done
	mkdir -p ${hdrdest}/include
	# Remove firmware stuff provided by the "linux-firmware" pkg.
	rm -rf ${DESTDIR}/usr/lib/firmware

	for i in acpi asm-generic clocksource config crypto drm generated linux vdso \
		math-emu media net pcmcia scsi sound trace uapi video xen dt-bindings hyperv keys; do
		if [ -d include/$i ]; then
			cp -a include/$i ${hdrdest}/include
		fi
	done

	cd ${wrksrc}
	mkdir -p ${hdrdest}/arch/${arch}
	cp -a arch/${arch}/include ${hdrdest}/arch/${arch}

	# needed for mv-debug
	cp scripts/sign-file "${XBPS_WRAPPERDIR}"

	# Remove helper binaries built for host,
	# if generated files from the scripts/ directory need to be included,
	# they need to be copied to ${hdrdest} before this step
	if [ "$CROSS_BUILD" ]; then
		make ${_toolchain_args} ${makejobs} ARCH=${subarch:-$arch} ${_cross} ${_make_flags} _mrproper_scripts
		# remove host specific objects as well
		find scripts -name '*.o' -delete
	fi

	# Copy files necessary for later builds, like nvidia and vmware
	cp Module.symvers ${hdrdest}
	cp -a scripts ${hdrdest}
	mkdir -p ${hdrdest}/security/selinux
	cp -a security/selinux/include ${hdrdest}/security/selinux
	mkdir -p ${hdrdest}/tools/include
	cp -a tools/include/tools ${hdrdest}/tools/include
	if [ -d "arch/${arch}/tools" ]; then
		cp -a "arch/${arch}/tools" "${hdrdest}/arch/${arch}"
	fi
	cp -a kernel/time/timeconst.bc "${hdrdest}/kernel/time"
	cp -a kernel/bounds.c "${hdrdest}/kernel"
	mkdir -p "${hdrdest}/arch/x86/entry/syscalls"
	cp -a arch/x86/entry/syscalls/syscall_32.tbl "${hdrdest}/arch/x86/entry/syscalls"

	mkdir -p ${hdrdest}/arch/${arch}/kernel
	cp arch/${arch}/Makefile ${hdrdest}/arch/${arch}
	if [ "$subarch" = "i386" ]; then
		mkdir -p ${hdrdest}/arch/x86
		cp arch/x86/Makefile_32.cpu ${hdrdest}/arch/x86
	fi
	if [ "$arch" = "x86" ]; then
		mkdir -p ${hdrdest}/arch/x86/kernel
		cp arch/x86/kernel/asm-offsets.s ${hdrdest}/arch/x86/kernel
	fi

	# add headers for lirc package
	# pci
	for i in bt8xx cx88 saa7134; do
		mkdir -p ${hdrdest}/drivers/media/pci/${i}
		cp -a drivers/media/pci/${i}/*.h ${hdrdest}/drivers/media/pci/${i}
	done
	# usb
	for i in em28xx pwc; do
		mkdir -p ${hdrdest}/drivers/media/usb/${i}
		cp -a drivers/media/usb/${i}/*.h ${hdrdest}/drivers/media/usb/${i}
	done
	# i2c
	mkdir -p ${hdrdest}/drivers/media/i2c
	cp drivers/media/i2c/*.h ${hdrdest}/drivers/media/i2c
	for i in cx25840; do
		mkdir -p ${hdrdest}/drivers/media/i2c/${i}
		cp -a drivers/media/i2c/${i}/*.h ${hdrdest}/drivers/media/i2c/${i}
	done

	# Add md headers
	mkdir -p ${hdrdest}/drivers/md
	cp drivers/md/*.h ${hdrdest}/drivers/md

	# Add inotify.h
	mkdir -p ${hdrdest}/include/linux
	cp include/linux/inotify.h ${hdrdest}/include/linux

	# Add wireless headers
	mkdir -p ${hdrdest}/net/mac80211/
	cp net/mac80211/*.h ${hdrdest}/net/mac80211

	# add dvb headers for http://mcentral.de/hg/~mrec/em28xx-new
	mkdir -p ${hdrdest}/drivers/media/dvb-frontends
	cp drivers/media/dvb-frontends/lgdt330x.h \
		${hdrdest}/drivers/media/dvb-frontends/
	cp drivers/media/i2c/msp3400-driver.h ${hdrdest}/drivers/media/i2c/

	# add dvb headers
	mkdir -p ${hdrdest}/drivers/media/usb/dvb-usb
	cp drivers/media/usb/dvb-usb/*.h ${hdrdest}/drivers/media/usb/dvb-usb/
	mkdir -p ${hdrdest}/drivers/media/dvb-frontends
	cp drivers/media/dvb-frontends/*.h ${hdrdest}/drivers/media/dvb-frontends/
	mkdir -p ${hdrdest}/drivers/media/tuners
	cp drivers/media/tuners/*.h ${hdrdest}/drivers/media/tuners/

	# Add xfs and shmem for aufs building
	mkdir -p ${hdrdest}/fs/xfs/libxfs
	mkdir -p ${hdrdest}/mm
	cp fs/xfs/libxfs/xfs_sb.h ${hdrdest}/fs/xfs/libxfs/xfs_sb.h

	# Add objtool binary, needed to build external modules with dkms
	case "$XBPS_TARGET_MACHINE" in
		x86_64*)
			mkdir -p ${hdrdest}/tools/objtool
			cp tools/objtool/objtool ${hdrdest}/tools/objtool
			;;
	esac

	# Extract debugging symbols and compress modules
	msg_normal "$pkgver: extracting debug info and compressing modules, please wait...\n"
	install -Dm644 vmlinux ${DESTDIR}/usr/lib/debug/boot/vmlinux-${_kernver}
	(
	cd ${DESTDIR}
	export DESTDIR
	export SIGN_FILE="${XBPS_WRAPPERDIR}/sign-file sha512 ${wrksrc}/certs/signing_key.pem ${wrksrc}/certs/signing_key.x509"
	find ./ -name '*.ko' -print0 | \
		xargs -0r -n1 -P ${XBPS_MAKEJOBS} ${FILESDIR}/mv-debug
	)
	# ... and run depmod again.
	depmod -b ${DESTDIR}/usr -F System.map ${_kernver}
	rm -f ${DESTDIR}/lib
}

linux7.2-tcachy-headers_package() {
	preserve=yes
	nostrip=yes
	noshlibprovides=yes
	short_desc+=" - source headers for 3rd party modules"
	pkg_install() {
		vmove usr/src
		vmove usr/lib/modules/${_kernver}/build
	}
}

linux7.2-tcachy-dbg_package() {
	preserve=yes
	nostrip=yes
	noverifyrdeps=yes
	noshlibprovides=yes
	repository=debug
	short_desc+=" - debugging symbols"
	pkg_install() {
		vmove usr/lib/debug
		vmove "boot/System.map-${_kernver}"
	}
}

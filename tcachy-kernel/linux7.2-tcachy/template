post_patch() {
	# avoid the strip wrapper, its used to copy the objects to a new location
	# and required to avoid absolute relocations.
	vsed -e "s|\$(STRIP) \(--strip-debug -o \$@ \$<;\)|/usr/bin/${STRIP} \1|" -i drivers/firmware/efi/libstub/Makefile

	# parallel pahole crashes on i686, do one job for now
	vsed -i "s/\(\$(pahole-flags-y)\)/\1 --jobs=1/" -i scripts/Makefile.btf
}

do_configure() {
	# If there's a file called <arch>-dotconfig, use it to
	# configure the kernel; otherwise use arch defaults and all stuff
	# as modules (allmodconfig).
	local arch subarch

	case "$XBPS_TARGET_MACHINE" in
		x86_64*) arch=x86_64;;
	esac

	if [ -f ${FILESDIR}/${subarch:-$arch}-dotconfig-custom ]; then
		msg_normal "Detected a custom .config file for your arch, using it.\n"
		cp -f ${FILESDIR}/${subarch:-$arch}-dotconfig-custom .config
	elif [ -f ${FILESDIR}/${subarch:-$arch}-dotconfig ]; then
		msg_normal "Detected a .config file for your arch, using it.\n"
		cp -f ${FILESDIR}/${subarch:-$arch}-dotconfig .config
	fi
	
	# Apply LTO mode
	if [ "$build_option_lto_full" ]; then
		scripts/config --enable CONFIG_LTO_CLANG
		scripts/config --enable CONFIG_LTO_CLANG_FULL
		scripts/config --disable CONFIG_LTO_CLANG_THIN
	elif [ "$build_option_lto_thin" ]; then
		scripts/config --enable CONFIG_LTO_CLANG
		scripts/config --enable CONFIG_LTO_CLANG_THIN
		scripts/config --disable CONFIG_LTO_CLANG_FULL
	else
		scripts/config --disable CONFIG_LTO_CLANG
		scripts/config --disable CONFIG_LTO_CLANG_FULL
		scripts/config --disable CONFIG_LTO_CLANG_THIN
	fi
	# Enable CachyOS-specific config tweaks
	scripts/config --enable CONFIG_CACHY

	# Apply CPU scheduler selection
	if [ "$build_option_bore" ]; then
		scripts/config --enable CONFIG_SCHED_BORE
	else
		scripts/config --disable CONFIG_SCHED_BORE
	fi

	# Apply default governor selection
	if [ "$build_option_performance" ]; then
		scripts/config --disable CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL
		scripts/config --enable CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE
	fi

	# Apply HZ ticks rate
	if [ "$build_option_hz100" ]; then
		scripts/config --enable CONFIG_HZ_100
		scripts/config --set-val CONFIG_HZ 100
	elif [ "$build_option_hz250" ]; then
		scripts/config --enable CONFIG_HZ_250
		scripts/config --set-val CONFIG_HZ 250
	elif [ "$build_option_hz300" ]; then
		scripts/config --enable CONFIG_HZ_300
		scripts/config --set-val CONFIG_HZ 300
	elif [ "$build_option_hz500" ]; then
		scripts/config --enable CONFIG_HZ_500
		scripts/config --set-val CONFIG_HZ 500
	elif [ "$build_option_hz600" ]; then
		scripts/config --enable CONFIG_HZ_600
		scripts/config --set-val CONFIG_HZ 600
	elif [ "$build_option_hz750" ]; then
		scripts/config --enable CONFIG_HZ_750
		scripts/config --set-val CONFIG_HZ 750
	elif [ "$build_option_hz800" ]; then
		scripts/config --enable CONFIG_HZ_800
		scripts/config --set-val CONFIG_HZ 800
	elif [ "$build_option_hz1000" ]; then
		scripts/config --enable CONFIG_HZ_1000
		scripts/config --set-val CONFIG_HZ 1000
	fi

	# Apply tick rate mode
	if [ "$build_option_tick_periodic" ]; then
		scripts/config --enable CONFIG_HZ_PERIODIC
	elif [ "$build_option_tick_idle" ]; then
		scripts/config --enable CONFIG_NO_HZ_IDLE
	elif [ "$build_option_tick_full" ]; then
		scripts/config --enable CONFIG_NO_HZ_FULL
		scripts/config --enable CONFIG_NO_HZ
		scripts/config --enable CONFIG_NO_HZ_COMMON
		scripts/config --enable CONFIG_CONTEXT_TRACKING
		scripts/config --enable CONFIG_CONTEXT_TRACKING_USER
	fi

	# Apply compiler optimization level
	if [ "$build_option_o3" ]; then
		scripts/config --disable CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE \
			--enable CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3
	fi

	# Disable kernel debug and tracing features
	if [ "$build_option_disable_debug" ]; then
		scripts/config --disable CONFIG_PAGE_POISONING
		scripts/config --disable CONFIG_SLUB_DEBUG
		scripts/config --disable CONFIG_SLUB_DEBUG_ON
		scripts/config --disable CONFIG_DEBUG_MEMORY_INIT
		scripts/config --disable CONFIG_SCHED_STACK_END_CHECK
		scripts/config --disable CONFIG_KFENCE
		scripts/config --disable CONFIG_SHRINKER_DEBUG
		scripts/config --disable CONFIG_CMA_DEBUGFS
		scripts/config --disable CONFIG_MODULE_DEBUGFS
		scripts/config --disable CONFIG_BLK_DEBUG_FS
		scripts/config --disable CONFIG_DEBUG_WX
		scripts/config --disable CONFIG_PTDUMP
		scripts/config --disable CONFIG_DEBUG_RODATA_TEST
		scripts/config --disable CONFIG_DEBUG_BUGVERBOSE
		scripts/config --disable CONFIG_ACPI_DEBUG
		scripts/config --disable CONFIG_PM_DEBUG
		scripts/config --disable CONFIG_PM_ADVANCED_DEBUG
		scripts/config --disable CONFIG_PM_SLEEP_DEBUG
		scripts/config --disable CONFIG_PM_TRACE_RTC
		scripts/config --disable CONFIG_LATENCYTOP
		scripts/config --disable CONFIG_LEDS_TRIGGER_CPU
		scripts/config --disable CONFIG_LEDS_TRIGGER_GPIO
		scripts/config --disable CONFIG_GENERIC_IRQ_DEBUGFS
		scripts/config --disable CONFIG_PRINTK_INDEX
		scripts/config --disable CONFIG_GENERIC_IRQ_STAT_SNAPSHOT
		scripts/config --disable CONFIG_FTRACE
		scripts/config --disable CONFIG_KPROBES
		scripts/config --disable CONFIG_UPROBES
		scripts/config --disable CONFIG_BPF_EVENTS
		scripts/config --disable CONFIG_PROBE_EVENTS
		scripts/config --disable CONFIG_TRACING
		scripts/config --disable CONFIG_BLK_DEV_IO_TRACE
		scripts/config -d 6LOWPAN_DEBUGFS
		scripts/config -d AF_RXRPC_DEBUG
		scripts/config -d AFS_DEBUG
		scripts/config -d AFS_DEBUG_CURSOR
		scripts/config -d ATA_VERBOSE_ERROR
		scripts/config -d ATH10K_DEBUG
		scripts/config -d ATH10K_DEBUGFS
		scripts/config -d ATH12K_DEBUG
		scripts/config -d ATH5K_DEBUG
		scripts/config -d ATH5K_TRACER
		scripts/config -d ATH6KL_DEBUG
		scripts/config -d ATH9K_HTC_DEBUGFS
		scripts/config -d ATM_ENI_DEBUG
		scripts/config -d ATM_IA_DEBUG
		scripts/config -d ATM_IDT77252_DEBUG
		scripts/config -d BCACHE_DEBUG
		scripts/config -d BCACHEFS_DEBUG
		scripts/config -d BEFS_DEBUG
		scripts/config -d BT_DEBUGFS
		scripts/config -d CEPH_LIB_PRETTYDEBUG
		scripts/config -d CFG80211_DEBUGFS
		scripts/config -d CIFS_DEBUG
		scripts/config -d CIFS_DEBUG2
		scripts/config -d CIFS_DEBUG_DUMP_KEYS
		scripts/config -d CROS_EC_DEBUGFS
		scripts/config -d CRYPTO_DEV_AMLOGIC_GXL_DEBUG
		scripts/config -d CRYPTO_DEV_CCP_DEBUGFS
		scripts/config -d DEBUG_BOOT_PARAMS
		scripts/config -d DEBUG_KMAP_LOCAL_FORCE_MAP
		scripts/config -d DEBUG_RSEQ
		scripts/config -d DEBUG_SHIRQ
		scripts/config -d DLM_DEBUG
		scripts/config -d DM_DEBUG_BLOCK_MANAGER_LOCKING
		scripts/config -d DM_DEBUG_BLOCK_STACK_TRACING
		scripts/config -d DM_UEVENT
		scripts/config -d DRM_ACCEL_IVPU_DEBUG
		scripts/config -d DRM_DEBUG_DP_MST_TOPOLOGY_REFS
		scripts/config -d DRM_DEBUG_MODESET_LOCK
		scripts/config -d DRM_DISPLAY_DP_TUNNEL_STATE_DEBUG
		scripts/config -d DRM_I915_DEBUG
		scripts/config -d DRM_I915_DEBUG_GUC
		scripts/config -d DRM_I915_DEBUG_MMIO
		scripts/config -d DRM_I915_DEBUG_VBLANK_EVADE
		scripts/config -d DRM_I915_DEBUG_WAKEREF
		scripts/config -d DRM_I915_SW_FENCE_DEBUG_OBJECTS
		scripts/config -d DRM_XE_DEBUG
		scripts/config -d DRM_XE_DEBUG_MEM
		scripts/config -d DRM_XE_DEBUG_MEMIRQ
		scripts/config -d DRM_XE_DEBUG_SRIOV
		scripts/config -d DRM_XE_DEBUG_VM
		scripts/config -d DVB_USB_DEBUG
		scripts/config -d EARLY_PRINTK_DBGP
		scripts/config -d EARLY_PRINTK_USB_XDBC
		scripts/config -d EXT4_DEBUG
		scripts/config -d HIST_TRIGGERS_DEBUG

+# ----------------------------------------------------- systemctl emulation ---
+# Это не systemctl. Это локальный compatibility-слой, чтобы меньше менять
+# существующий код. Внешние systemd-команды не вызываются.
+
+def sysctl_user(*args, timeout=15):
+    argv = [str(a) for a in args]
+    if not argv:
+        return 0, "", ""
+
+    verb = argv[0]
+
+    if verb == "daemon-reload":
+        return daemon_reload()
+
+    if verb == "is-active":
+        unit = argv[1] if len(argv) > 1 else ""
+        state = unit_state(unit)
+        return (0 if state == "active" else 3), state + "\n", ""
+
+    if verb == "is-enabled":
+        unit = argv[1] if len(argv) > 1 else ""
+        enabled = unit_enabled(unit)
+        return (
+            0 if enabled else 1,
+            ("enabled\n" if enabled else "disabled\n"),
+            "",
+        )
+
+    if verb == "enable":
+        now = "--now" in argv
+        units = [a for a in argv[1:] if not a.startswith("-")]
+        for u in units:
+            enable_unit(u)
+            if now:
+                start_unit(u)
+        return 0, "", ""
+
+    if verb == "disable":
+        now = "--now" in argv
+        units = [a for a in argv[1:] if not a.startswith("-")]
+        for u in units:
+            disable_unit(u)
+            if now:
+                stop_unit(u)
+        return 0, "", ""
+
+    if verb == "start":
+        units = [a for a in argv[1:] if not a.startswith("-")]
+        for u in units:
+            rc, _, err = start_unit(u)
+            if rc != 0:
+                return rc, "", err
+        return 0, "", ""
+
+    if verb == "stop":
+        units = [a for a in argv[1:] if not a.startswith("-")]
+        for u in units:
+            rc, _, err = stop_unit(u)
+            if rc != 0:
+                return rc, "", err
+        return 0, "", ""
+
+    if verb == "restart":
+        units = [a for a in argv[1:] if not a.startswith("-")]
+        for u in units:
+            rc, _, err = restart_unit(u)
+            if rc != 0:
+                return rc, "", err
+        return 0, "", ""
+
+    if verb == "show":
+        units = [
+            a
+            for a in argv[1:]
+            if not a.startswith("-") and a != "MainPID"
+        ]
+        unit = units[-1] if units else ""
+        pid = service_pid(unit)
+        return 0, f"{pid}\n", ""
+
+    return 1, "", f"unsupported service verb: {verb}"

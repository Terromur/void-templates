+def _executable(path: Path) -> bool:
+    try:
+        return path.is_file() and os.access(path, os.X_OK)
+    except OSError:
+        return False
+
+
+def _binary_cache(name: str) -> Path:
+    return state_dir() / f"{name}.path"
+
+
+def _save_binary(name: str, path: str | Path):
+    atomic_write(_binary_cache(name), str(path) + "\n")
+
+
+def _cached_binary(name: str) -> str | None:
+    txt = _read_text(_binary_cache(name)).strip()
+    if txt and _executable(Path(txt)):
+        return txt
+    return None
+
+
+def locate_binary(name: str, required: bool = False) -> str | None:
+    """
+    Найти исполняемый файл:
+
+    1. переменные окружения;
+    2. кэш в ~/.local/state/pipewire-controller/<name>.path;
+    3. рядом с уже найденным pipewire;
+    4. PATH;
+    5. уже запущенный процесс в /proc;
+    6. типовые каталоги.
+
+    Если required=True и не нашли — RuntimeError.
+    """
+    for env in _BINARY_ENV.get(name, ()):
+        val = os.environ.get(env)
+        if val:
+            p = Path(val).expanduser()
+            if _executable(p):
+                _save_binary(name, p)
+                return str(p)
+
+    cached = _cached_binary(name)
+    if cached:
+        return cached
+
+    # Для pw-link / pipewire-pulse / wireplumber полезно искать рядом
+    # с уже найденным pipewire.
+    if name != "pipewire":
+        pw = locate_binary("pipewire", required=False)
+        if pw:
+            cand = Path(pw).parent / name
+            if _executable(cand):
+                _save_binary(name, cand)
+                return str(cand)
+
+    found = shutil.which(name)
+    if found:
+        _save_binary(name, found)
+        return found
+
+    found = _find_running_binary(name)
+    if found:
+        _save_binary(name, found)
+        return found
+
+    for d in _COMMON_BIN_DIRS:
+        cand = Path(d) / name
+        if _executable(cand):
+            _save_binary(name, cand)
+            return str(cand)
+
+    if required:
+        raise RuntimeError(
+            f"{name} binary not found. "
+            f"Set one of {_BINARY_ENV.get(name, ())} or add it to PATH."
+        )
+    return None
+
+
+def pipewire_binary(required: bool = True) -> str | None:

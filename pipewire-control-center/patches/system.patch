+def journal_tail(
+    units=None,
+    lines=200,
+    cursor: str | None = None,
+    priority: str | None = None,
+) -> tuple[str, str | None]:
+    """
+    Замена journalctl.
+
+    Читает логи из файлов, которые пишет наш менеджер процессов.
+    cursor хранит размеры файлов, чтобы при повторном вызове
+    получать только новые строки.
+    """
+    if units is None:
+        units = [f"{x}.service" for x in MAIN_SERVICES]
+
+    files = []
+    for u in units:
+        p = unit_log_path(u)
+        if p.is_file():
+            files.append(p)
+
+    state = {}
+    if cursor:
+        try:
+            state = json.loads(cursor)
+        except ValueError:
+            state = {}
+
+    chunks = []
+    new_state = {}
+
+    if cursor is None:
+        for p in files:
+            chunks.append(tail_file(p, lines))
+            try:
+                new_state[str(p)] = p.stat().st_size
+            except OSError:
+                pass
+    else:
+        for p in files:
+            key = str(p)
+            try:
+                size = p.stat().st_size
+            except OSError:
+                continue
+
+            prev_raw = state.get(key)
+            if prev_raw is None:
+                # Файл появился после прошлого курсора:
+                # не вываливать сразу всю историю.
+                prev = size
+            else:
+                try:
+                    prev = int(prev_raw)
+                except ValueError:
+                    prev = size
+
+            if size < prev:
+                prev = 0
+
+            if size > prev:
+                try:
+                    with open(p, "rb") as f:
+                        f.seek(prev)
+                        chunks.append(f.read().decode("utf-8", "replace"))
+                except OSError:
+                    pass
+
+            new_state[key] = size
+
+    return "\n".join(c for c in chunks if c).strip(), json.dumps(new_state)
+

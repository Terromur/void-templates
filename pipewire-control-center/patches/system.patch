+def tail_file(path, lines=200) -> str:
+    lines = int(lines)
+    if lines <= 0:
+        return ""
+
+    try:
+        with open(path, "rb") as f:
+            f.seek(0, os.SEEK_END)
+            end = f.tell()
+            if end == 0:
+                return ""
+
+            block = 4096
+            data = b""
+            pos = end
+
+            while pos > 0 and data.count(b"\n") <= lines:
+                step = min(block, pos)
+                pos -= step
+                f.seek(pos)
+                data = f.read(step) + data
+
+            text = data.decode("utf-8", "replace")
+            return "\n".join(text.splitlines()[-lines:])
+    except OSError:
+        return ""
 
 

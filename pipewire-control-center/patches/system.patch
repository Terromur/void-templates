+# -------------------------------------------------------------- pid helpers ---
+
+def _pid_alive(pid: int) -> bool:
+    if pid <= 0:
+        return False
+    try:
+        os.kill(pid, 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    except OSError:
+        return False
+    return True
+
+
+def _wait_pid_gone(pid: int, timeout: float = 5.0) -> bool:
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        if not _pid_alive(pid):
+            return True
+        time.sleep(0.1)
+    return not _pid_alive(pid)
+
+
+def _proc_args(pid: int) -> list[str]:
+    try:
+        data = Path(f"/proc/{pid}/cmdline").read_bytes()
+    except OSError:
+        return []
+    return [x.decode("utf-8", "replace") for x in data.split(b"\0") if x]
+
+
+def _proc_env(pid: int) -> dict[str, str]:
+    try:
+        data = Path(f"/proc/{pid}/environ").read_bytes()
+    except OSError:
+        return {}
+    out = {}
+    for item in data.split(b"\0"):
+        if b"=" in item:
+            k, v = item.split(b"=", 1)
+            out[k.decode("utf-8", "replace")] = v.decode("utf-8", "replace")
+    return out
+
+
+def _comm(pid: int) -> str:
+    try:
+        return Path(f"/proc/{pid}/comm").read_text(
+            encoding="utf-8", errors="replace"
+        ).strip()
+    except OSError:
+        return ""
+
+
+def _is_controller_chain_pid(pid: int) -> bool:
+    env = _proc_env(pid)
+    return env.get("PIPEWIRE_CONFIG_DIR") == str(GENERATED_DIR)
+
+
+def find_pids_by_comm(comm: str, exclude_controller: bool = False) -> list[int]:
+    out = []
+    me = os.getuid()
+    try:
+        entries = os.listdir("/proc")
+    except OSError:
+        return out
+
+    for entry in entries:
+        if not entry.isdigit():
+            continue
+        pid = int(entry)
+        try:
+            if os.stat(f"/proc/{entry}").st_uid != me:
+                continue
+
+            c = _comm(pid)
+            match = (
+                c == comm
+                or (len(comm) > 15 and c == comm[:15])
+            )
+
+            if not match:
+                args = _proc_args(pid)
+                if args and os.path.basename(args[0]) == comm:
+                    match = True
+
+            if not match:
+                continue
+
+            if exclude_controller and _is_controller_chain_pid(pid):
+                continue
+
+            out.append(pid)
+        except OSError:
+            continue
+
+    return sorted(out)
+
+
+def _find_running_binary(comm: str) -> str | None:
+    for pid in find_pids_by_comm(comm, exclude_controller=False):
+        try:
+            exe = Path(f"/proc/{pid}/exe").resolve()
+            if exe.is_file():
+                return str(exe)
+        except OSError:
+            continue
+    return None

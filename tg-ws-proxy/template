do_install() {
	vbin "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_bin}" tg-ws-proxy
        vlicense "${XBPS_SRCDISTDIR}/${pkgname}-${version}/LICENSE"
	vinstall /dev/stdin 644 usr/share/applications tg-ws-proxy.desktop <<EOF
[Desktop Entry]
Type=Application
Name=TG WS Proxy
Comment=Telegram Desktop WebSocket bridge proxy
Exec=tg-ws-proxy
Categories=Network;
EOF
}

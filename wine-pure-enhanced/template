do_extract() {
    mkdir -p "${wrksrc}/wine" "${wrksrc}/wine-staging"

    tar xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/wine-${_commit}.tar.gz" \
        -C "${wrksrc}/wine" --strip-components=1
        
    tar xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}/wine-staging-${_staging_commit}.tar.gz" \
        -C "${wrksrc}/wine-staging" --strip-components=1

    cp "${FILESDIR}/30-win32-aliases.conf" "${FILESDIR}/wine-binfmt.conf" "${wrksrc}/"

    msg_normal "Cloning external patch repositories...\n"
    git clone --depth 1 https://github.com/GloriousEggroll/proton-ge-custom.git "${wrksrc}/proton-ge-custom"
    git clone --depth 1 https://github.com/NelloKudo/spritz-wine.git "${wrksrc}/spritz-wine"
    git clone --depth 1 https://github.com/starcitizen-lug/patches.git "${wrksrc}/patches"
    git clone --depth 1 https://github.com/elgabo86/gwine.git "${wrksrc}/gwine"
    git clone --depth 1 https://github.com/whrvt/wine-osu-patches.git "${wrksrc}/wine-osu-patches"
}
pre_configure() {
    cd "${wrksrc}/wine"
    
    python3 ../wine-staging/staging/patchinstall.py \
    --backend=patch --all

    local patches=(
        "0001-HACK-wine.inf-Add-native-builtin-overrides-for-msvcr.patch"
        "0002-wine.inf-Set-a-valid-Win10-ProductId.patch"
        "0003-wineboot-On-prefix-upgrade-update-win10-build-number.patch"
        "0004-wineboot-Generate-better-DigitalProductId.patch"
        "0005-wineboot-Load-root-certificates-on-prefix-update.patch"
        "Disable-optimization-of-some-functions.patch"
        "winecfg-Add-tweaks-tab-page.patch"
        "ntdll-loader-add-support-for-overriding-IMAGE_FILE_L.patch"
        "Add-workarounds-for-game-launchers.patch"
        "0001-HACK-ws2_32-Block-first-internet-connection-for-some.patch"
        "Configure-Enforce-4-byte-stack-alignment-on-clang-for-PE-builds.patch"
        "10108.patch"
        "10829.patch"
        "10864.patch"
        "kernelbase-Handle-misaligned-stack-in-OpenThread.patch"
        "joystick.patch"
        "no-winemenubuilder.patch"
        "access-alignment-property.patch"
        "kernel32-tests-expand-locking-coverage.patch"
        "kernelbase-signal-unlockfileex-events.patch"
        "win32u-map-oem-charset.patch"
        "wineserver-close-released-lock-fds.patch"
        "10892.patch"
        "10805.patch"
        "10547.patch"
        "10471.patch"
        "9640.patch"
        "8484.patch"
        "4908.patch"
        "wine-msvcrt-binary-ccs-utf8-bom.patch"
        "wine-msvcrt-narrow-open-createfilea.patch"
        "wine-pipe-file-position.patch"
        "0006-comdlg32-use-XDG-Desktop-Portal-for-native-file-dial.patch"
        "0007-comdlg32-fix-portal-dialog-compatibility-and-respons.patch"
        "0008-comdlg32-add-wow64-unix-call-table-for-32-bit.patch"
        "proton-em-winewayland.patch"
)

    for p in "${patches[@]}"; do
        if [ -f "${FILESDIR}/${p}" ]; then
            patch ${patch_args} -i "${FILESDIR}/${p}"
        fi
    done
    
        local proton_patches_dir="${wrksrc}/proton-ge-custom/patches"
    if [ -d "${proton_patches_dir}" ]; then
      while IFS= read -r -d '' p; do
        msg_normal "Applying proton-ge-custom patches: ${p#${proton_patches_dir}/}"
        patch ${patch_args} < "$p"
      done < <(find "${proton_patches_dir}" \
        -type f \
        -name "*.patch" \
        -not -path "${proton_patches_dir}/discordrpc/*" \
        -not -path "${proton_patches_dir}/dxvk/*" \
        -not -path "${proton_patches_dir}/game-patches/layered-overlay-wine.patch" \
        -not -path "${proton_patches_dir}/game-patches/maplestory-kernelbase-charprev-null.patch" \
        -not -path "${proton_patches_dir}/ge-video-rework/*" \
        -not -path "${proton_patches_dir}/lsteamclient/*" \
        -not -path "${proton_patches_dir}/pipewire/*" \
        -not -path "${proton_patches_dir}/proton-ds5-haptic/*" \
        -not -path "${proton_patches_dir}/proton/0001-De-steamify-proton-s-WINE-so-it-can-be-used-as-a-sta.patch" \
        -not -path "${proton_patches_dir}/proton/0001-HACK-kernelbase-allow-overriding-dlls-for-DLSS-XeSS-.patch" \
        -not -path "${proton_patches_dir}/proton/0001-fshack-Implement-AMD-FSR-upscaler-for-fullscreen-hac.patch" \
        -not -path "${proton_patches_dir}/proton/0001-win32u-Implement-NtGdiDdDDIQueryAdapterInfo-cases.patch" \
        -not -path "${proton_patches_dir}/proton/0001-win32u-add-env-switch-to-disable-wm-decorations.patch" \
        -not -path "${proton_patches_dir}/proton/83-nv_low_latency_wine.patch" \
        -not -path "${proton_patches_dir}/proton/0002-HACK-ntdll-add-optiscaler-inection-hack.patch" \
        -not -path "${proton_patches_dir}/proton/wine_host_block_envvar.patch" \
        -not -path "${proton_patches_dir}/proton/winex11-mutter-cinnamon.patch" \
        -not -path "${proton_patches_dir}/protonfixes/*" \
        -not -path "${proton_patches_dir}/vkd3d-proton/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/disabled/0210-winedmo-Handle-demuxer-URLs-without-an-extension.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/em-fixups/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/0001-decouple-wineopenxr-from-steamvr-and-integrate-it-in.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/0001-server-Dynamically-relocate-.exes-by-default-too.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/0002-ntdll-allow-disabling-executable-ASLR.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/icuuc-icuin-forwarder-dlls.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/ntdll-prefer-native-version-resource-heuristics.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/secur32-fallback-without-no-shuffle-extensions.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/0009-HACK-kernel32-Spoof-GetProcAddress-of-KiUserApcDispa.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/ntdll-reserve-top-down-space-for-large-address-aware-wow64.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/ntdll-remove-redundant-packed-split-lock.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/pending/winex11-use-x11-drawables-for-steam-opengl-overlay.patch" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/comctl32_animate_avi/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/mmsystem.dll16-MIDIHDR_Refcount/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/windowscodecs-TIFF_Support/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/winex11-Fixed-scancodes/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-staging/winex11-ime-check-thread-data/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wine-wayland/*" \
        -not -path "${proton_patches_dir}/wine-hotfixes/wineland-child-rendering/*" \
        -not -path "${proton_patches_dir}/wineopenxr/*" \

    local spritz_patches_dir="${wrksrc}/spritz-wine/patches"
    if [ -d "${spritz_patches_dir}" ]; then
      while IFS= read -r -d '' p; do
        msg_normal "Applying spritz patches: ${p#${spritz_patches_dir}/}"
        patch ${patch_args} < "$p"
      done < <(find "${spritz_patches_dir}" \
        -type f \
        -name "*.patch" \
        -not -path "${spritz_patches_dir}/0001-spritz/0002-HACK-ws2_32-Block-first-internet-connection-for-some.patch" \
        -not -path "${spritz_patches_dir}/0001-spritz/0007-loader-Copy-arial.ttf-to-fonts.patch" \
        -not -path "${spritz_patches_dir}/0003-tkg/0001-ntdll-loader-add-support-for-overriding-IMAGE_FILE_L.patch" \
        -not -path "${spritz_patches_dir}/0004-proton-fsync/*" \
        -not -path "${spritz_patches_dir}/0006-misc/0004-ntdll-Never-use-CLOCK_REALTIME_COARSE.patch" \
        -not -path "${spritz_patches_dir}/0006-misc/0009-ntoskrnl.exe-Add-stub-for-KeGetCurrentIrql.patch" \
        -not -path "${spritz_patches_dir}/0007-winewayland/*" \
        -not -path "${spritz_patches_dir}/0008-pending-MR/10829-Futex-optimizations/*" \
        -not -path "${spritz_patches_dir}/0008-pending-MR/11339-winegstreamer-wma-decoder-Implement-Get-Input-Output-CurrentType/*" \
        -print0 | sort -z)
    fi
    
        local starcitizen_lug_dir="${wrksrc}/patches"
    if [ -d "${starcitizen_lug_dir}" ]; then
      while IFS= read -r -d '' p; do
        msg_normal "Applying starcitizen_lug patches: ${p#${starcitizen_lug_dir}/}"
        patch ${patch_args} < "$p"
      done < <(find "${starcitizen_lug_dir}" \
        -type f \
        -name "*.patch" \
        -not -path "${starcitizen_lug_dir}/mesa/*" \
        -not -path "${starcitizen_lug_dir}/proton/*" \
        -not -path "${starcitizen_lug_dir}/vkd3d-proton/*" \
        -not -path "${starcitizen_lug_dir}/xorg/*" \
        -not -path "${starcitizen_lug_dir}/wine/10.2+_eac_fix.patch" \
        -not -path "${starcitizen_lug_dir}/wine/printkey_x11-staging.patch" \
        -not -path "${starcitizen_lug_dir}/wine/eac_60101_timeout.patch" \
        -not -path "${starcitizen_lug_dir}/wine/9196_process_idle_event_client_side.patch" \
        -not -path "${starcitizen_lug_dir}/wine/append_cmd_override.patch" \
        -not -path "${starcitizen_lug_dir}/wine/hidewineexports.patch" \
        -not -path "${starcitizen_lug_dir}/wine/reg_show_wine.patch" \
        -not -path "${starcitizen_lug_dir}/wine/revert-egl-default.patch" \
        -not -path "${starcitizen_lug_dir}/wine/winefacewarehacks-minimal.patch" \
        -not -path "${starcitizen_lug_dir}/wine/wineland_pointer_warping.patch" \
        -not -path "${starcitizen_lug_dir}/wine/winewayland-no-enter-move-if-relative.patch" \
        -not -path "${starcitizen_lug_dir}/wine/real_path.patch" \
        -not -path "${starcitizen_lug_dir}/wine/0001-wineopenxr_add.patch" \
        -not -path "${starcitizen_lug_dir}/wine/0002-wineopenxr_enable.patch" \
        -not -path "${starcitizen_lug_dir}/wine/silence-sc-unsupported-os.patch" \
        -not -path "${starcitizen_lug_dir}/wine/default-to-wayland.patch" \
        -not -path "${starcitizen_lug_dir}/wine/0079-HACK-winewayland-add-support-for-picking-primary-mon.patch" \
        -not -path "${starcitizen_lug_dir}/wine/0088-fixup-HACK-winewayland-add-support-for-picking-prima.patch" \
        -not -path "${starcitizen_lug_dir}/wine/winewayland-fullscreen-idle-inhibit.patch" \
        -not -path "${starcitizen_lug_dir}/wine/winewayland-guess-primary-output.patch" \
        -print0 | sort -z)
    fi
    
        local gwine_patches_dir="${wrksrc}/gwine/patches"
    if [ -d "${gwine_patches_dir}" ]; then
      while IFS= read -r -d '' p; do
        msg_normal "Applying gwine patches: ${p#${gwine_patches_dir}/}"
        patch ${patch_args} < "$p"
      done < <(find "${gwine_patches_dir}" \
        -type f \
        -name "*.mypatch" \
        -not -path "${gwine_patches_dir}/cpuid_fault_handler.mypatch" \
        -not -path "${gwine_patches_dir}/disable_mediaconv_fallback.mypatch" \
        -not -path "${gwine_patches_dir}/faketime.mypatch" \
        -not -path "${gwine_patches_dir}/mpeg4_m4s2_decoder_fix.mypatch" \
        -not -path "${gwine_patches_dir}/use_real_username.mypatch" \
        -not -path "${gwine_patches_dir}/winewayland-keep-toplevel-for-client-surfaces.mypatch" \
        -not -path "${gwine_patches_dir}/wmadec_getcurrenttype.mypatch" \
        -print0 | sort -z)
    fi
            local wine_osu_patches_dir="${wrksrc}/wine-osu-patches"
    if [ -d "${wine_osu_patches_dir}" ]; then
      while IFS= read -r -d '' p; do
        msg_normal "Applying wine-osu-patches patches: ${p#${wine_osu_patches_dir}/}"
        patch ${patch_args} < "$p"
      done < <(find "${wine_osu_patches_dir}" \
        -type f \
        -name "*.patch" \
        -not -path "${wine_osu_patches_dir}/0003-pending-mrs-and-backports/*" \
        -not -path "${wine_osu_patches_dir}/0004-build-fix-undebug-optimize/0001-LTO-fixup.patch" \
        -not -path "${wine_osu_patches_dir}/0004-build-fix-undebug-optimize/2000-configure-Enforce-4-byte-stack-alignment-on-clang-fo.patch" \
        -not -path "${wine_osu_patches_dir}/0004-build-fix-undebug-optimize/5500-include-Prefer-builtin-atomics-unless-they-re-known-.patch" \
        -not -path "${wine_osu_patches_dir}/0004-build-fix-undebug-optimize/6000-server-Disable-debug-features-if-NDEBUG-is-d.patch" \
        -not -path "${wine_osu_patches_dir}/0009-windowing-system-integration/*" \
        -not -path "${wine_osu_patches_dir}/0012-audio/*" \
        -not -path "${wine_osu_patches_dir}/0013-server-optimization/*" \
        -not -path "${wine_osu_patches_dir}/0015-bernhard-asan/*" \
        -not -path "${wine_osu_patches_dir}/0016-proton-additions/*" \
        -not -path "${wine_osu_patches_dir}/9000-misc-additions/*" \
        -print0 | sort -z)
    fi
    
    ./dlls/winevulkan/make_vulkan
    ./tools/make_requests
    ./tools/make_specfiles
    autoreconf -f
}
do_configure() {
    export CC="clang" CXX="clang++"
    export AR=llvm-ar
    export RANLIB=llvm-ranlib
    export NM=llvm-nm
    local _base_flags="-march=native -mtune=native -O2 -pipe -fno-stack-protector -fno-stack-check -fno-math-errno -fno-trapping-math -fno-semantic-interposition -fcf-protection=none -mharden-sls=none -fno-ident"
    export CFLAGS="${_base_flags} -D_FILE_OFFSET_BITS=64 -D_FORTIFY_SOURCE=0"
    export CXXFLAGS="${CFLAGS} -DNDEBUG -Wp,-U_GLIBCXX_ASSERTIONS"
    export CROSSCFLAGS="${_base_flags} -D_FORTIFY_SOURCE=0" 
    export CROSSCXXFLAGS="${CROSSCFLAGS} -DNDEBUG -Wp,-U_GLIBCXX_ASSERTIONS"
    export CROSSLDFLAGS="-Wl,/FILEALIGN:4096,/INCREMENTAL:NO,/LTCG,/OPT:REF,/OPT:ICF=3"
    export LDFLAGS="-fuse-ld=lld -flto=auto -O3 -Wl,--lto-O3 -Wl,--as-needed -Wl,-Bsymbolic-functions -Wl,-z,pack-relative-relocs -Wl,--strip-all -Wl,--icf=safe -Wl,--build-id=none -Wl,-z,norelro"

    cd "${wrksrc}/wine"
    ./configure --prefix=/usr --libdir=/usr/lib ${configure_args}
}
do_build() {
    cd "${wrksrc}/wine"
    make ${makejobs}
}
do_install() {
    cd "${wrksrc}/wine"
    make DESTDIR="${DESTDIR}" install

    ln -sf wine "${DESTDIR}/usr/bin/wine64"

    llvm-strip --strip-unneeded \
        "${DESTDIR}/usr/lib/wine/i386-windows/"*.{dll,exe} \
        "${DESTDIR}/usr/lib/wine/x86_64-windows/"*.{dll,exe} 2>/dev/null || true

    vmkdir usr/share/fontconfig/conf.avail
    vmkdir usr/share/fontconfig/conf.default
    vinstall "${wrksrc}/30-win32-aliases.conf" 644 usr/share/fontconfig/conf.avail
    ln -s ../conf.avail/30-win32-aliases.conf \
        "${DESTDIR}/usr/share/fontconfig/conf.default/30-win32-aliases.conf"

    vinstall "${wrksrc}/wine-binfmt.conf" 644 usr/lib/binfmt.d wine.conf

    vmkdir usr/lib/modules-load.d
    echo "ntsync" > "${DESTDIR}/usr/lib/modules-load.d/wine-pure.conf"
}

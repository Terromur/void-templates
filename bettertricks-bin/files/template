# Template file for 'bettertricks-bin'
pkgname=bettertricks-bin
version=1.0
revision=1
archs="x86_64"
short_desc="Recovery-first Wine prefix manager and Winetricks-compatible recipe engine (binary)"
maintainer="Ramazan Berk Şirin <ramazanberksirin@protonmail.com>"
homepage="https://github.com/RamazanBerk20/Bettertricks"
license="LGPL-2.1-or-later"

depends="
    libwebkit2gtk41
    cabextract
    7zip
    unzip
    gzip
    tar
    xz
    zstd
"
hostmakedepends="libarchive"

# Пакет-заглушка: конфликтует с AUR/Arch-версией
conflicts="bettertricks"
provides="bettertricks-${version}_${revision}"

_debname="Bettertricks_${version}_amd64.deb"
distfiles="
    ${_debname}::${homepage}/releases/download/v${version}/${_debname}
    LICENSE::${homepage}/raw/v${version}/LICENSE
    bettertricks.desktop::${homepage}/raw/v${version}/packaging/linux/io.bettertricks.desktop.desktop
    bettertricks.metainfo.xml::${homepage}/raw/v${version}/packaging/linux/io.bettertricks.desktop.metainfo.xml
"
checksum="
    80d8ba1f08e9fac32950c58f11c237f6add0f6924355aaf90f88dca8520aa0d6
    bb826495e04f20eef046c421e2b8ac01fea99fc90215badf0185a210aa4a5208
    244031234c734653393af7bb4c7145fe97ad4512e772192507156c006164fb87
    00ea4cfade9ea542dfd4e4157e426a21e94e6d9682d4c659fb28b82d2a438a27
"
noextract="${_debname}"
skiprdeps="/usr/lib/bettertricks/Bettertricks"

do_install() {
    # Распаковываем data.tar.gz из .deb
    bsdtar -xOf "${XBPS_SRCDISTDIR}/${_debname}" data.tar.gz | \
        bsdtar -xf - -C "${DESTDIR}"

    # Удаляем оригинальный .desktop-файл, установленный из .deb
    rm -f "${DESTDIR}/usr/share/applications/Bettertricks.desktop"

    # Устанавливаем правильные метафайлы
    vinstall "${XBPS_SRCDISTDIR}/bettertricks.desktop" 644 \
        usr/share/applications io.bettertricks.desktop.desktop

    vinstall "${XBPS_SRCDISTDIR}/bettertricks.metainfo.xml" 644 \
        usr/share/metainfo io.bettertricks.desktop.metainfo.xml

    vlicense "${XBPS_SRCDISTDIR}/LICENSE"
}

--- a/build-win32.txt
+++ b/build-win32.txt
@@ -1,10 +1,17 @@
 [binaries]
-c = 'i686-w64-mingw32-gcc'
-cpp = 'i686-w64-mingw32-g++'
-ar = 'i686-w64-mingw32-ar'
-strip = 'i686-w64-mingw32-strip'
+c = '/opt/llvm-mingw/bin/i686-w64-mingw32-clang'
+cpp = '/opt/llvm-mingw/bin/i686-w64-mingw32-clang++'
+ar = '/opt/llvm-mingw/bin/llvm-ar'
+strip = '/opt/llvm-mingw/bin/llvm-strip'
+windres = [ '/opt/llvm-mingw/bin/llvm-windres', '--target=i686-w64-mingw32' ]
 widl-mingw-tools-fallback = 'i686-w64-mingw32-widl'
 
+[built-in options]
+c_args=[@CARGS@]
+cpp_args=[@CXXARGS@]
+c_link_args = [@LDARGS@]
+cpp_link_args = [@LDARGS@]
+
 [properties]
 needs_exe_wrapper = true
 

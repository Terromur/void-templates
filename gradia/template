# Template file for Gradia – screenshot annotation and editing tool
pkgname=gradia
version=1.13.0
revision=1
build_style=meson
hostmakedepends="AppStream blueprint-compiler git meson pkg-config python3-pip gettext desktop-file-utils"
makedepends="glib-devel gdk-pixbuf-devel graphene-devel gtk4-devel gtksourceview5-devel libadwaita-devel libportal-devel libsoup3-devel pango-devel python3-cairo python3-gobject python3-Pillow python3-gobject-devel"
depends="glib gdk-pixbuf graphene gtk4 gtksourceview5 libadwaita libportal libsoup3 pango python3-cairo python3-gobject python3-Pillow tesseract-ocr"
short_desc="Screenshot annotation and editing tool"
maintainer="Your Name <you@example.com>"
license="GPL-3.0-or-later"
homepage="https://apps.gnome.org/Gradia/"
distfiles="https://github.com/AlexanderVanhee/Gradia/archive/v${version}.tar.gz"
checksum=bba20396de4b7e515597207828ef7e9f3906711a24399b39a52c7dac2333eb0b
post_install() {
    # Install pytesseract via pip
    pip3 install --prefix=/usr --root="${DESTDIR}" pytesseract
}

do_install() {
    meson install -C build --destdir "${DESTDIR}"

    # Compile Python bytecode
    python3 -m compileall -d /usr/share "${DESTDIR}/usr/share"
    python3 -O -m compileall -d /usr/share "${DESTDIR}/usr/share"

    # Remove bundled font
    rm -rf "${DESTDIR}/usr/share/fonts"
}
